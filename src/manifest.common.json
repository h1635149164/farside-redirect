{
  "name": "Farside Redirector",
  "version": "0.1.1",
  "description": "Automatically redirects privacy-invasive domains to farside.link frontends.",
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "32": "icons/icon-32.png",
      "64": "icons/icon-64.png",
      "72": "icons/icon-72.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png",
      "512": "icons/icon-512.png"
    }
  },
  "icons": {
    "32": "icons/icon-32.png",
    "64": "icons/icon-64.png",
    "72": "icons/icon-72.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "512": "icons/icon-512.png"
  }
}
